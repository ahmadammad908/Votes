# Environment Variables Example for CampusFace

# Application
NODE_ENV=development
PORT=4000
API_BASE_URL=http://localhost:4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://postgres:miamalkova@localhost:5432/campusface_db?schema=public"

# Redis Cache & Queues
REDIS_URL="redis://localhost:6379"

# Security & Authentication
JWT_SECRET=super_secret_jwt_key_at_least_32_characters_long_for_dev_only
JWT_REFRESH_SECRET=super_secret_refresh_jwt_key_32_characters_long_for_dev_only
COOKIE_SECRET=super_secret_cookie_signing_key_32_chars_long

# CORS
CORS_ORIGIN=http://localhost:3000

# Rate Limiting
RATE_LIMIT_MAX_PER_MINUTE=100

# Storage (Local in dev, S3 in prod)
STORAGE_DRIVER=local
STORAGE_LOCAL_PATH=./uploads
# S3_ENDPOINT=
# S3_REGION=auto
# S3_BUCKET=campusface-media
# S3_ACCESS_KEY_ID=
# S3_SECRET_ACCESS_KEY=
